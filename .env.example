# csax+ configuration example.
#
# Copy to `.env` for local development. Every value below is a placeholder.
# Never commit a real `.env`.
#
# Resolution order for any setting FOO (see src/server/config):
#   1. process.env.FOO
#   2. process.env.FOO_FILE  -> read the file at that path, trimming a trailing newline
#   3. ./csax.config.json (or the path in CSAX_CONFIG_FILE)
#   4. a documented default (non-sensitive settings only)

# ---------------------------------------------------------------------------
# CrydenSync API (the console is a BFF in front of this; see BUILD_NOTE 11.1)
# ---------------------------------------------------------------------------

# Base URL of the CrydenSync HTTP API. The console calls /v1/* and /v1/admin/*.
CSAX_API_URL=http://127.0.0.1:8080

# `live` talks to CSAX_API_URL. `fixtures` serves labelled sample data for
# offline demos only; it is never a silent fallback for a real call.
CRYDEN_MODE=fixtures

# ---------------------------------------------------------------------------
# Console store (csax+'s own small store: passkeys, vault, console audit, prefs)
# This is NOT the engine's primary database. Give it its own role.
# ---------------------------------------------------------------------------

# Postgres connection string for the console store. Exactly one of
# CSAX_STORE_URL or CSAX_STORE_SQLITE_PATH must be set; setting both is a boot error.
CSAX_STORE_URL=postgres://<console-user>:<password>@<host>:5432/<console-database>

# SQLite file used instead of Postgres for local/dev.
# CSAX_STORE_SQLITE_PATH=./csax-console.sqlite

# SELECT-only role used by the allowlisted read-only AI query templates.
# This is the only database credential the AI layer may ever touch.
READONLY_DATABASE_URL=postgres://<readonly-user>:<password>@<host>:5432/<engine-database>

# ---------------------------------------------------------------------------
# Console secrets
# ---------------------------------------------------------------------------

# Signs and encrypts the operator session cookie. 32 random bytes, base64.
# Generate: openssl rand -base64 32
CSAX_SESSION_SECRET=<base64-encoded-32-random-bytes>

# AES-256-GCM key protecting vault-stored secrets at rest. 32 bytes, base64.
# Generate: openssl rand -base64 32
CSAX_VAULT_KEY=<base64-encoded-32-random-bytes>

# ---------------------------------------------------------------------------
# The console's own origin
# ---------------------------------------------------------------------------

# Full origin, including scheme and port. Every mutation the browser makes is
# checked against it, so a request from anywhere else is refused.
#
# The relying party for passkeys is NOT here: passkeys belong to the operator's
# account at the API, so the API's own WEBAUTHN_RP_ID and WEBAUTHN_RP_ORIGINS
# decide them. This console only relays the ceremony.
WEBAUTHN_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Email (delivery stats and "send test" on the Email screen)
# ---------------------------------------------------------------------------

RESEND_API_KEY=<your-email-provider-api-key>

# ---------------------------------------------------------------------------
# AI provider (every AI feature is read-only, always)
# ---------------------------------------------------------------------------

# anthropic | openai | azure-openai | openai-compatible
LLM_PROVIDER=anthropic

# Keys are read through the secrets layer, never sent to the browser.
ANTHROPIC_API_KEY=<your-anthropic-api-key>
OPENAI_API_KEY=<your-openai-api-key>

# ---------------------------------------------------------------------------
# Operational
# ---------------------------------------------------------------------------

# error | warn | info | debug
LOG_LEVEL=info

# Set to 1 to stop the console applying its own store migrations on boot.
SKIP_AUTO_MIGRATE=0
