# Copy to .env.docker. Replace the generated values before deployment.
CSAX_API_URL=http://host.docker.internal:8080
CRYDEN_MODE=live
CSAX_SESSION_SECRET=replace-with-output-from-openssl-rand-base64-32
CSAX_VAULT_KEY=replace-with-a-different-output-from-openssl-rand-base64-32
WEBAUTHN_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Optional. This is a separate SELECT-only database connection for AI queries,
# not CSAG's authentication DATABASE_URL.
# READONLY_DATABASE_URL=postgres://readonly:password@host.docker.internal:5432/product
