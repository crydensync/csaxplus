#!/bin/sh
# commit-msg hook for csax+.
#
# Requires the two user-requested co-author trailers and rejects generated
# tool attribution or any other co-author trailer.
# Also rejects em dashes and en dashes anywhere in the message.
# then hands off to commitlint for Conventional Commits enforcement.
#
# Em and en dashes are built from their UTF-8 bytes so this file itself never
# contains the characters it forbids.

set -e

msg_file="$1"
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
  echo "commit-msg: no commit message file given" >&2
  exit 1
fi

crydensync_author='Co-authored-by: CrydenSync Official <crydensync@gmail.com>'
raymond_author='Co-authored-by: Raymond Proguy <devraymond24@gmail.com>'
author_count=$(grep -ic '^Co-authored-by:' "$msg_file" || true)
if [ "$author_count" -ne 2 ] || ! grep -Fqx "$crydensync_author" "$msg_file" || ! grep -Fqx "$raymond_author" "$msg_file"; then
  echo "commit-msg: include the two required co-author trailers exactly once." >&2
  exit 1
fi

if grep -qi 'generated with' "$msg_file"; then
  echo "commit-msg: refusing generated tool attribution." >&2
  exit 1
fi

dash_em=$(printf '\342\200\224')
dash_en=$(printf '\342\200\223')
if grep -qF -e "$dash_em" -e "$dash_en" "$msg_file"; then
  echo "commit-msg: refusing em and en dashes; use a hyphen, comma, or parentheses." >&2
  exit 1
fi

exec pnpm exec commitlint --edit "$msg_file"
